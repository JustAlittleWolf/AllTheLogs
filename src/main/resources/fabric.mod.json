{
  "schemaVersion": 1,
  "id": "allthelogs",
  "version": "${version}",
  "name": "All The Logs",
  "description": "Search all of your minecraft message history across sessions, using the stored logs.",
  "authors": [
    "JustAlittleWolf"
  ],
  "contact": {
    "sources": "https://github.com/JustAlittleWolf/AllTheLogs"
  },
  "license": "MIT",
  "icon": "assets/allthelogs/icon.png",
  "environment": "client",
  "mixins": [
    "allthelogs.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "me.wolfii.allthelogs.client.AllTheLogsClient"
    ],
    "modmenu": [
      "me.wolfii.allthelogs.client.AllTheLogsModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "fabric-api": "*",
    "owo": "*",
    "yet_another_config_lib_v3": ">=3.9.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
